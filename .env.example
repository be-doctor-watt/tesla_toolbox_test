# Copier en .env et compléter. Le .env est ignoré par git.

# Modèle de langage (llm.py). Sans clé, l'assistant renvoie les extraits
# sourcés sans synthèse rédigée. Tier gratuit : console.mistral.ai
MISTRAL_API_KEY=
# mistral-large-latest part en read timeout sur le tier gratuit (mesuré) ;
# medium repond en ~0,3 s. Le repli est essaye si le principal ne repond pas.
# MISTRAL_MODELE=mistral-medium-latest
# MISTRAL_MODELE_REPLI=mistral-small-latest
# LLM_TIMEOUT_S=45

# Embeddings (rag.py). local = rien ne sort de la machine.
# RAG_BACKEND=local
# RAG_MODEL=intfloat/multilingual-e5-large
# RAG_DB=./qdrant_data

# Cache des articles bruts (harvest.py, live.py)
# TBX_RAW=raw
# TBX_LOCALE=en_US

# Aspiration en ligne de commande uniquement. Le chat, lui, demande le jeton
# dans l'interface et le garde en mémoire, jamais sur disque.
# TBX_TOKEN=
# TBX_COOKIE=
